{
  "name": "@rell333/rellui",
  "version": "0.1.35",
  "type": "module",
  "description": "A React component library built on React Aria Components and Tailwind CSS v4",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
