    "react-aria-components": "^1.19.0",
    "tailwind-variants": "^3.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "5.6"
  }
